<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    android:layout_marginTop="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- University Logo -->
        <ImageView
            android:id="@+id/univ_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="100dp"
            android:maxHeight="100dp"
            android:adjustViewBounds="true"
            android:src="@drawable/citelogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- RSO Text -->
        <TextView
            android:id="@+id/uniformRSO"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="RSO"
            android:textColor="@android:color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/univ_logo"
            app:layout_constraintTop_toTopOf="@id/univ_logo"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Size -->
        <TextView
            android:id="@+id/uniformSizes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Size: Small"
            android:textSize="17sp"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@id/uniformRSO"
            app:layout_constraintTop_toBottomOf="@id/uniformRSO"
            app:layout_constraintEnd_toEndOf="@id/uniformRSO" />

        <!-- Department -->
        <TextView
            android:id="@+id/uniformDepartment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Department"
            android:textSize="17sp"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@id/uniformSizes"
            app:layout_constraintTop_toBottomOf="@id/uniformSizes"
            app:layout_constraintEnd_toEndOf="@id/uniformSizes" />

        <!-- Total Available -->
        <TextView
            android:id="@+id/tvTotalAvailable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Total Available"
            android:textSize="17sp"
            android:textColor="@android:color/black"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="@id/uniformDepartment"
            app:layout_constraintTop_toBottomOf="@id/uniformDepartment"
            app:layout_constraintEnd_toEndOf="@id/uniformDepartment" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
